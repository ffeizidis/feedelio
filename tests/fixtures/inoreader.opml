<?xml version="1.0" encoding="UTF-8"?>
<opml version="1.0">
    <head>
        <title>Subscriptions of feedelio</title>
        <dateCreated>Sat, 14 Feb 2026 09:12:44 +0000</dateCreated>
    </head>
    <body>
        <outline text="News" title="News">
            <outline text="Feedelio Test Feed" title="Feedelio Test Feed" type="rss" xmlUrl="https://example.com/atom.xml" htmlUrl="https://example.com/"/>
            <outline text="Feedelio RSS 2.0 Feed" title="Feedelio RSS 2.0 Feed" type="rss" xmlUrl="https://rss.example.com/feed.xml" htmlUrl="https://rss.example.com/"/>
        </outline>
        <outline text="Tech" title="Tech">
            <outline text="Feedelio RSS 1.0 Feed" title="Feedelio RSS 1.0 Feed" type="rss" xmlUrl="https://rdf.example.com/feed.rdf" htmlUrl="https://rdf.example.com/"/>
            <!-- Inoreader itself keeps folders flat; other readers nest, and a
                 nested export has to land somewhere until nested folders (M2). -->
            <outline text="Rust" title="Rust">
                <outline text="This Week in Rust" title="This Week in Rust" type="rss" xmlUrl="https://this-week-in-rust.org/rss.xml" htmlUrl="https://this-week-in-rust.org/"/>
            </outline>
        </outline>
        <outline text="Saved for later" title="Saved for later"/>
        <outline text="Uncategorised Blog" title="Uncategorised Blog" type="rss" xmlUrl="https://blog.example.com/index.xml" htmlUrl="https://blog.example.com/"/>
    </body>
</opml>
